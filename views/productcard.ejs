<% products.forEach(product => {
    const discountedPrice = product.discount > 0
      ? product.price - (product.price * product.discount / 100)
      : product.price;
%>
  <div class="flex flex-col justify-between items-center text-center border-2 border-black p-4 rounded-lg shadow-md bg-white">
    <img src="/<%= product.image %>" alt="<%= product.name %>" class="w-full h-auto" />
    <h3 class="text-base sm:text-lg font-bold mt-2"><%= product.name %></h3>
    <p class="text-sm my-1"><%= product.details %></p>
    <% if (product.discount > 0) { %>
      <p class="text-base font-bold text-black">
        <span class="line-through text-gray-500">₹ <%= product.price %></span>
        <span class="text-green-600 ml-2">₹ <%= discountedPrice.toFixed(2) %></span>
      </p>
      <span class="bg-orange-400 text-white text-xs px-2 py-1 rounded mt-1 inline-block"><%= product.discount %>% Off</span>
    <% } else { %>
      <p class="text-base font-bold text-black">₹ <%= product.price %></p>
    <% } %>
    <button class="bg-blue-700 text-white px-4 py-2 text-sm w-full mt-2 rounded hover:bg-gray-800 transition">ADD TO CART</button>
  </div>
<% }) %>
