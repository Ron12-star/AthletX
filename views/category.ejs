<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= isSearchPage ? "Search Results" : categoryName + " Collection" %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-sans bg-gray-100 m-0 p-0">
  <header class="text-center py-4 px-2">
    <h2 class="text-2xl sm:text-3xl font-semibold break-words">
      <%= categoryName %> Collection
    </h2>
  </header>

  <div class="flex flex-col lg:flex-row max-w-[1200px] mx-auto p-4 lg:p-5 pb-40 gap-4">
   <a href="/"
  class="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-50 
         bg-black text-white font-semibold text-sm sm:text-base 
         border border-black px-4 py-2 rounded-full 
         hover:bg-orange-600 hover:border-orange-600 
         transition-transform duration-300 hover:scale-105 
         text-center no-underline">
  Continue Shopping
</a>





    <!-- Sidebar -->
    <aside
      class="w-full lg:w-[280px] p-4 bg-gray-100 border border-gray-200 rounded-lg shadow-sm hover:border-gray-400 hover:shadow-md transition">
      <h2 class="text-xl sm:text-2xl uppercase tracking-wide font-semibold text-gray-800 mb-5">Filters</h2>

      <!-- Price Filter -->
      <label for="min-price" class="block mb-2 font-semibold text-gray-700">Price</label>
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 mb-5">
        <div class="flex flex-col items-center w-full sm:w-auto">
          <input type="number" id="min-price"
            class="w-full sm:w-[70px] px-2 py-1 border border-gray-300 rounded text-sm mb-1" value="100" min="100"
            max="<%= maxPrice %>" step="50" />
          <input type="range" id="price-min" class="w-full appearance-none h-[6px] bg-gray-300 rounded cursor-pointer"
            min="100" max="<%= maxPrice %>" step="50" value="100" />
        </div>
        <span class="text-sm text-gray-500">To</span>
        <div class="flex flex-col items-center w-full sm:w-auto">
          <input type="number" id="max-price"
            class="w-full sm:w-[70px] px-2 py-1 border border-gray-300 rounded text-sm mb-1" value="<%= maxPrice %>"
            min="100" max="<%= maxPrice %>" step="50" />
          <input type="range" id="price-max" class="w-full appearance-none h-[6px] bg-gray-300 rounded cursor-pointer"
            min="100" max="<%= maxPrice %>" step="<%= maxPrice % 50 === 0 ? 50 : 1 %>" value="<%= maxPrice %>" />
        </div>
      </div>

      <!-- Subcategory Filter -->
      <h3 class="text-lg sm:text-xl font-semibold text-gray-800 mt-5 mb-3">Category</h3>
      <input type="text" id="subcategorySearch" placeholder="Search..."
        class="w-full px-3 py-2 border border-gray-300 rounded text-sm mb-3" />
      <div id="subcategoryList" class="max-h-[200px] overflow-y-auto border border-gray-300 p-2 rounded space-y-2">
        <% if (subcategories.length> 0) { %>
          <% subcategories.filter(subcategory=> subcategory && subcategory.trim() !== "").forEach(subcategory => { %>
            <label class="block font-medium text-gray-700">
              <input type="checkbox" name="subcategory" value="<%= subcategory %>" class="mr-2 align-middle" />
              <%= subcategory %>
            </label>
            <% }); %>
              <% } else { %>
                <p>No subcategories available</p>
                <% } %>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="w-full lg:w-[75%]">
      <h2 class="text-xl sm:text-2xl font-bold mb-4">🔥 Bestsellers in <%= categoryName %> 🔥</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5"
        id="bestseller-products">
        <% if (bestsellerProducts.length> 0) { %>
          <% bestsellerProducts.forEach(product=> {
            const hasDiscount = product.discount > 0;
            const discountedPrice = hasDiscount
            ? product.price - (product.price * product.discount / 100)
            : product.price;
            %>
            <div
              class="flex flex-col justify-between items-center text-center border-2 border-black p-4 rounded-lg shadow-md bg-white relative transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg">
              <span class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded z-10">🔥
                Bestseller</span>
              <% if (hasDiscount) { %>
                <span class="absolute top-2 right-2 bg-orange-400 text-white text-xs font-bold px-2 py-1 rounded z-10">
                  <%= product.discount %>% Off
                </span>
                <% } %>
                  <img src="/<%= product.image %>" alt="<%= product.name %>" class="w-full h-auto mt-6 mb-2 rounded" />
                  <h3 class="text-base sm:text-lg font-bold mt-1">
                    <%= product.name %>
                  </h3>
                  <p class="text-sm my-1">
                    <%= product.details %>
                  </p>
                  <% if (hasDiscount) { %>
                    <p class="text-base font-bold text-black">
                      <span class="line-through text-gray-500">₹ <%= product.price %></span>
                      &nbsp;
                      <span class="text-green-600">₹ <%= discountedPrice.toFixed(2) %></span>
                    </p>
                    <% } else { %>
                      <p class="text-base font-bold text-black">₹ <%= product.price %>
                      </p>
                      <% } %>
                      <button 
  class="add-to-cart bg-black text-white px-4 py-2 text-sm w-full mt-2 rounded hover:bg-gray-800 transition"
  data-productid="<%= product._id %>">
  ADD TO CART
</button>
            </div>
            <% }) %>
              <% } else { %>
                <p class="text-gray-600">No bestseller products available in this category.</p>
                <% } %>
      </div>

      <h2 class="text-xl sm:text-2xl font-bold mt-8 mb-4">All products in <%= categoryName %>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5" id="all-products">
        <% if (products.length> 0) { %>
          <% products.forEach(product=> {
            const hasDiscount = product.discount > 0;
            const discountedPrice = hasDiscount
            ? product.price - (product.price * product.discount / 100)
            : product.price;
            %>
            <div
              class=" relative flex flex-col justify-between items-center text-center border-2 border-black p-4 rounded-lg shadow-md bg-white">
             <img src="/<%= product.image %>" alt="<%= product.name %>" class="w-full h-auto mt-6" />

              <h3 class="text-base sm:text-lg font-bold mt-2">
                <%= product.name %>
              </h3>
              <p class="text-sm my-1">
                <%= product.details %>
              </p>
              <% if (hasDiscount) { %>
                <p class="text-base font-bold text-black">
                  <span class="line-through text-gray-500">₹ <%= product.price %></span>
                  &nbsp;
                  <span class="text-green-600">₹ <%= discountedPrice.toFixed(2) %></span>
                </p>
                <span class="absolute top-2 right-2 bg-orange-400 text-white text-xs font-bold px-2 py-1 rounded z-10">
                  <%= product.discount %>% Off
                </span>

                <% } else { %>
                  <p class="text-base font-bold text-black">₹ <%= product.price %>
                  </p>
                  <% } %>
                    <button 
  class="add-to-cart bg-blue-700 text-white px-4 py-2 text-sm w-full mt-2 rounded hover:bg-gray-800 transition"
  data-productid="<%= product._id %>">
  ADD TO CART
</button>
            </div>
            <% }) %>
              <% } else { %>
                <p class="text-gray-600">No products available in this category.</p>
                <% } %>
      </div>
    </main>


  </div>

  <script src="/static/category.js"></script>
</body>

</html>