<!DOCTYPE html>
<html lang="en">

<head>
  <script src="https://cdn.tailwindcss.com"></script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home - ATHLETEX</title>
  <link rel="stylesheet" href="/css/home.css" type="text/css" />
   
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

</head>

<body>
  <main>
<div class="w-full flex justify-center bg-white sticky top-0 z-[1000] shadow-md">
  <div class="panel w-full max-w-screen-xl px-2 sm:px-4 lg:px-6 py-2 sm:py-3 space-y-2 sm:space-y-0">
    
    <!-- Responsive Wrapper -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      
      <!-- Logo + Search -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between flex-1 gap-2">
        <!-- Logo -->
        <a href="/" class="flex justify-center sm:justify-start">
          <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-black">ATHLETEX</h3>
        </a>

        <!-- Search Bar -->
        <form action="/search" method="GET" class="flex flex-col sm:flex-row sm:items-center w-full gap-2">
          <input type="text" name="q" id="search-input"
            class="w-full sm:w-auto flex-1 px-4 py-2 text-sm sm:text-base border border-black rounded-full focus:ring-2 focus:ring-orange-500 outline-none"
            placeholder="Search products..." required />
          <button type="submit"
            class="w-full sm:w-auto px-6 py-2 bg-black text-white font-medium rounded-full transition hover:bg-orange-600 hover:scale-105">
            Search
          </button>
        </form>
      </div>

      <!-- Buttons -->
      <div class="flex flex-wrap justify-center lg:justify-end items-center gap-2 mt-2 lg:mt-0">
        <% if (session && session.user) { %>
          <a href="/profile" class="flex items-center gap-1 px-4 py-2 bg-black text-white text-sm rounded-md shadow hover:bg-gray-800 transition">
            <i class="fa-solid fa-user"></i>
            <span>Profile</span>
          </a>
        <% } else { %>
          <a href="/login" class="flex items-center gap-1 px-4 py-2 bg-black text-white text-sm rounded-md shadow hover:bg-gray-800 transition">
            <i class="fa-solid fa-sign-in-alt"></i>
            <span>Login</span>
          </a>
        <% } %>

        <a href="/Wishlist" class="flex items-center gap-1 px-4 py-2 bg-black text-white text-sm rounded-md shadow hover:bg-gray-800 transition">
          <i class="fa-regular fa-heart"></i>
          <span>Wishlist</span>
        </a>

        <a href="/add-to-cart" class="flex items-center gap-1 px-4 py-2 bg-black text-white text-sm rounded-md shadow hover:bg-gray-800 transition">
          <i class="fa-solid fa-cart-shopping"></i>
          <span>Cart</span>
        </a>

        <a href="/order-status" class="flex items-center gap-1 px-4 py-2 bg-black text-white text-sm rounded-md shadow hover:bg-gray-800 transition">
          <i class="fa-solid fa-box"></i>
          <span>Track Order</span>
        </a>
      </div>
    </div>

  </div>
</div>





<div class="discount_panel h-[100px] w-full bg-black relative">
  <div id="discount"
    class="flex items-center justify-between bg-yellow-400 h-[23px] w-full relative transition-opacity ease-in-out duration-500 opacity-100">
    <div class="discount_one flex items-center justify-center h-full w-[95%] relative">
      <p>FREE delivery above $999/- Applicable on ATHLETEX Products only</p>
    </div>
    <i class="fa-solid fa-x absolute cursor-pointer" id="closeButton"></i>
  </div>
  <img src="/Images/offer image.avif" alt="Offer image" class="w-full h-full" />
</div>


    <div class="category-container">
      <a href="/category/WinterCollection" class="category-box">
        <img src="/Images/Winter-collection.avif" alt="Winter Collection" />
        <p>Winter Collection</p>
      </a>
      <a href="/category/Men" class="category-box">
        <img src="/Images/men.avif" alt="Men" />
        <p>Men</p>
      </a>
      <a href="/category/Women" class="category-box">
        <img src="/Images/women.avif" alt="Women" />
        <p>Women</p>
      </a>
      <a href="/category/Kids" class="category-box">
        <img src="/Images/Kids.avif" alt="Kids" />
        <p>Kids</p>
      </a>
      <a href="/category/Shoes" class="category-box">
        <img src="/Images/Shoes.avif" alt="Shoes" />
        <p>Shoes</p>
      </a>
      <a href="/category/Equipment & Cycles" class="category-box">
        <img src="/Images/Equipment & cycles.avif" alt="Equsipment & Cycles" />
        <p>Equipment & Cycles</p>
      </a>
      <a href="/category/Bags & Backpacks" class="category-box">
        <img src="/Images/Bags-and-Backpacks.avif" alt="Bags & Backpacks" />
        <p>Bags & Backpacks</p>
      </a>
      <a href="/category/Sports Accessories" class="category-box">
        <img src="/Images/Sport-Accessories.avif" alt="Sport Accessories" />
        <p>Sport Accessories</p>
      </a>
    </div>
    <!-- --------------------------------------------------------------------------- -->
    <div class="carousel-container">
      <div class="carousel" id="carouselTop">
        <div class="slide">
          <img src="/7.avif" alt="Ad 1" />
        </div>
        <div class="slide">
          <img src="/upper2.avif" alt="Ad 2" />
        </div>
        <div class="slide">
          <img src="/lower2.avif" alt="Ad 3" />
        </div>
        <div class="slide">
          <img src="/8.avif" alt="Ad 4" />
        </div>
      </div>

      <button class="scroll-btn scroll-left" onclick="scrollCarousel(-1)">
        &#10094;
      </button>
      <button class="scroll-btn scroll-right" onclick="scrollCarousel(1)">
        &#10095;
      </button>
    </div>
    <!-- -------------------------------------------------------------- -->
    <div id="after_advertisement">
      <img src="/Images/after advertisement.avif" alt="" />
    </div>
    <br>
    <br>
    <!-- High Discount Product Slider -->
    <div class="heading">
      <h1>High discount</h1>
    </div>
    <br>
    <br>
    <div class="product-container" id="highDiscountContainer">

      <button class="scroll-btn scroll-left" data-target="discount_list">&#10094;</button>

      <div id="product_list" class="scroll-wrapper">
        <div class="product-slider">
          <% if (HighDiscountProducts && HighDiscountProducts.length> 0) { %>
            <% HighDiscountProducts.forEach(product=> { %>
              <div class="product-card high-discount">
                <img src="<%= product.image %>" alt="<%= product.name %>" />
                <h3>
                  <%= product.name %>
                </h3>
                <p>
                  Price: <del style="text-decoration: line-through; color: gray;">₹ <%= product.price %></del>
                  <strong style="color: green;">₹<%= (product.price - (product.price * product.discount / 100)).toFixed(2) %></strong>
                </p>
                <p>
                  <%= product.details %>
                </p>
                <p class="highlight">Discount: <%= product.discount %>%</p>
                <button class="add-to-cart" data-productid="<%= product._id %>">Add to Cart</button>
                 <form action="/Wishlist" method="POST" style="display:inline;">
                       <input type="hidden" name="productId" value="<%= product._id %>" />
                      <button type="submit" class="wishlist-btn">Add to Wishlist</button>
                    </form>
              </div>
              <% }) %>
                <% } else { %>
                  <p>No high-discount products available.</p>
                  <% } %>
        </div>
      </div>
      <button class="scroll-btn scroll-right" data-target="discount_list">&#10095;</button>
      <button id="toggleHighDiscount" class="toggle-view-btn"
        onclick="toggleView('highDiscountContainer', 'toggleHighDiscount')">
        Show All Products
      </button>
    </div>
    <br>
    <br>
    <!---------------------------------------------------------------------------->
    <div class="carousel-container">
      <div class="carousel">
        <div class="slide"><img src="/lower1.avif" alt="Ad 1" /></div>
        <div class="slide"><img src="/lower2.avif" alt="Ad 2" /></div>
        <div class="slide"><img src="/lower3.avif" alt="Ad 3" /></div>
        <div class="slide"><img src="/9.avif" alt="Ad 3" /></div>
        <div class="slide"><img src="/10.avif" alt="Ad 3" /></div>
      </div>
      <button type="button" class="scroll-btn scroll-left carousel-btn" data-target="carousel">&#10094;</button>
      <button type="button" class="scroll-btn scroll-right carousel-btn" data-target="carousel">&#10095;</button>
    </div>
    <br>
    <br>
    <!-- low Discount Product Slider -->
      <div class="heading">
      <h1>Low discount</h1>
    </div>
    <br>
    <br>
    <div class="product-container" id="lowDiscountContainer">
      <button type="button" class="scroll-btn scroll-left" data-target="product_list">&#10094;</button>


      <div id="product_list" class="scroll-wrapper">
        <div class="product-slider">
          <% if (LowDiscountProducts && LowDiscountProducts.length> 0) { %>
            <% LowDiscountProducts.forEach(product=> { %>
              <div class="product-card low-discount">
                <img src="<%= product.image %>" alt="<%= product.name %>" />
                <h3>
                  <%= product.name %>
                </h3>
                <p>
                  Price:
                  <% if (product.discount> 0) { %>
                    <del style="text-decoration: line-through; color: gray;">₹ <%= product.price %></del>
                    <% } %>
                      <strong style="color: green;">₹<%= (product.price - (product.price * product.discount / 100)).toFixed(2) %></strong>
                </p>
                <p>
                  <%= product.details %>
                </p>
                <% if (product.discount> 0) { %>
                  <p class="highlight"> Discount: <%= product.discount %>%</p>
                  <% } %>
                    <button type="button" class="add-to-cart" data-productid="<%= product._id %>">Add to Cart</button>
                    <!-- ✅ Add to Wishlist Button -->
                    <form action="/Wishlist" method="POST" style="display:inline;">
                       <input type="hidden" name="productId" value="<%= product._id %>" />
                      <button type="submit" class="wishlist-btn">Add to Wishlist</button>
                    </form>

              </div>
              <% }) %>
                <% } else { %>
                  <p>No low-discount products available.</p>
                  <% } %>
        </div>
      </div>
      <button type="button" class="scroll-btn scroll-right" data-target="product_list">&#10095;</button>
      <button id="toggleLowDiscount" class="toggle-view-btn"
        onclick="toggleView('lowDiscountContainer', 'toggleLowDiscount')">
        Show All Products
      </button>
    </div>
    <br>
    <br>
   <footer class="bg-black text-white py-12 px-6 md:px-20">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
    <!-- Company Info -->
    <div>
      <h2 class="text-2xl font-bold flex items-center gap-2 mb-4">
        🚴‍♂️ Athlete
      </h2>
      <p class="text-sm leading-relaxed">
        At AthleteX, we empower every athlete — men, women, and children — with premium sports equipment and performance-ready apparel. Whether you're hitting the gym, the field, or the track, our gear is designed to elevate your game and style. Your journey to greatness starts here.
      </p>
      <div class="flex gap-4 mt-4">
        <a href="#" class="hover:opacity-75 text-white"><i class="fab fa-instagram"></i></a>
        <a href="#" class="hover:opacity-75 text-white"><i class="fab fa-linkedin"></i></a>
        <a href="#" class="hover:opacity-75 text-white"><i class="fab fa-youtube"></i></a>
        <a href="#" class="hover:opacity-75 text-white"><i class="fab fa-facebook"></i></a>
      </div>
    </div>

    <!-- Company Links -->
    <div>
      <h3 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-3">Company</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="#" class="hover:text-gray-300 text-white">About</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Team</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Shop</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Privacy Policy</a></li>
      </ul>
    </div>

    <!-- Services -->
    <div>
      <h3 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-3">Our Services</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="#" class="hover:text-gray-300 text-white">Personal Gear Fitting</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Online Sports Coaching</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Sports Equipment Rental</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Equipment Repair & Maintenance</a></li>
        <li><a href="#" class="hover:text-gray-300 text-white">Local Sports Events</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-3">Contact</h3>
      <ul class="space-y-2 text-sm">
        <li class="flex items-center gap-2">
          <i class="fas fa-map-marker-alt"></i> Ahmedabad, Gujarat, India
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-phone"></i> 12 345 678 9101
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-envelope"></i> AthleteX@gmail.com
        </li>
      </ul>
    </div>
  </div>

  <div class="mt-12 border-t border-gray-700 pt-4 text-center text-sm">
    <p>All Rights Reserved</p>
    <div class="mt-2 space-x-4">
      <a href="#" class="text-white hover:underline">Terms & Condition</a>
      <a href="#" class="stext-white hover:underline">Privacy Policy</a>
      <a href="#" class="text-white hover:underline">Contact Us</a>
    </div>
  </div>
</footer>

